# All generated artifacts are written below this directory.
KARE_DATA_DIR=./data

# Set one or both after downloading MIMIC through PhysioNet.
# MIMIC-III: directory containing ADMISSIONS.csv, PATIENTS.csv, ...
MIMIC3_ROOT=/absolute/path/to/mimiciii/1.4
# MIMIC-IV: hosp directory containing admissions.csv.gz, patients.csv.gz, ...
MIMIC4_ROOT=/absolute/path/to/mimiciv/2.2/hosp

# DyPH-RAG prepared cutoff-safe datasets and versioned external evidence.
DYPHRAG_MIMIC3_JSONL=./data/processed/dyphrag_mimiciii_full.jsonl
DYPHRAG_MIMIC4_JSONL=
DYPHRAG_MEDICAL_CORPUS=
DYPHRAG_ID_SALT_FILE=./data/.dyphrag_id_salt

# LLM providers (only needed for KG/context/reasoning generation).
OPENAI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Optional local model/cache locations.
KARE_MODEL_CACHE=./data/models
KARE_TRAIN_FILE=./data/llm_finetune_data/mimic4_mortality_train.jsonl
KARE_TEST_FILE=./data/llm_finetune_data/mimic4_mortality_test.jsonl
